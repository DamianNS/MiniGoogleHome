[Unit]
Description=Smart Home Media Bridge Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=smarthome
Group=smarthome
WorkingDirectory=/opt/smarthome-media-bridge/backend
ExecStart=/usr/bin/dotnet /opt/smarthome-media-bridge/backend/SmartHome.Backend.dll
EnvironmentFile=/etc/smarthome-media-bridge/smarthome.env
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/smarthome-media-bridge

[Install]
WantedBy=multi-user.target
