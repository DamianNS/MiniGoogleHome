# Copiar a /etc/smarthome-media-bridge/smarthome.env y proteger con chmod 640.
ConnectionStrings__SharedDatabase=Data Source=/var/lib/smarthome-media-bridge/smarthome.db
Database__ApplyMigrations=false
InitialAdmin__Username=admin
InitialAdmin__Password=CAMBIAR_FUERA_DEL_REPOSITORIO
InitialAdmin__AgentUserId=usr_master_pi_01
OAuth__ClientId=CAMBIAR_CLIENT_ID
OAuth__ClientSecret=CAMBIAR_CLIENT_SECRET
OAuth__AllowedRedirectUris__0=https://example.invalid/oauth/callback
OAuth__AuthorizationCodeLifetimeSeconds=300
OAuth__AccessTokenLifetimeSeconds=3600
Audio__MpvPath=/usr/bin/mpv
Audio__YtDlpPath=/usr/bin/yt-dlp
Audio__AmixerPath=/usr/bin/amixer
Audio__MixerName=Master
Backend__BaseUrl=http://127.0.0.1:5000/
ASPNETCORE_ENVIRONMENT=Production
