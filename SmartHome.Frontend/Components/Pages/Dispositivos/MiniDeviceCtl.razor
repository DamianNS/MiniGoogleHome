<div class="card mini-player shadow-sm my-2">
    <div class="card-body p-2 d-flex flex-column flex-sm-row align-items-center justify-content-between gap-3">
        
        <div class="device-info text-truncate text-center text-sm-start" title="@DeviceData?.Nombre">
            <h6 class="mb-0 text-truncate fw-bold">@(DeviceData?.Nombre ?? "Cargando...")</h6>
        </div>

        <fieldset disabled="@(DeviceData == null)" class="border-0 p-0 m-0">
            <div class="player-controls d-flex align-items-center justify-content-center gap-2">
                <!-- Mute -->
                <button class="btn btn-sm btn-outline-secondary btn-icon" title="Mute">
                    <i class="bi bi-volume-mute-fill fs-5"></i>
                </button>
                
                <!-- Previous -->
                <button class="btn btn-sm btn-outline-primary btn-icon" title="Anterior">
                    <i class="bi bi-skip-backward-fill fs-5"></i>
                </button>
                
                <!-- Play / Pause -->
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-primary" title="Play" @onclick="PlayCommand">
                        <i class="bi bi-play-fill fs-4"></i>
                    </button>
                    <button class="btn btn-primary" title="Pause">
                        <i class="bi bi-pause-fill fs-4"></i>
                    </button>
                </div>
                
                <!-- Stop -->
                <button class="btn btn-sm btn-danger btn-icon" title="Stop">
                    <i class="bi bi-stop-fill fs-5"></i>
                </button>
                
                <!-- Next -->
                <button class="btn btn-sm btn-outline-primary btn-icon" title="Siguiente">
                    <i class="bi bi-skip-forward-fill fs-5"></i>
                </button>
            </div>
        </fieldset>
    </div>
</div>

