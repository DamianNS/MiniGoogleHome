@page "/dashboard"

<PageTitle>Dashboard</PageTitle>

<h1 class="h2 mb-4">Dashboard</h1>

@if (LoadError is not null)
{
    <div class="alert alert-danger" role="alert">No se pudieron cargar todos los datos: @LoadError</div>
}

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <p class="text-secondary mb-1">Backend</p>
                <p class="h4 mb-0"><span class="badge @BackendBadgeClass">@BackendStatus</span></p>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <p class="text-secondary mb-1">Volumen actual</p>
                <p class="h4 mb-0">@(CurrentVolume is null ? "No disponible" : $"{CurrentVolume}%")</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <p class="text-secondary mb-1">Tokens válidos</p>
                <p class="h4 mb-0">@ValidTokens.Count</p>
            </div>
        </div>
    </div>
</div>

<section class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <h2 class="h5">Tokens OAuth activos</h2>
        @if (ValidTokens.Count == 0)
        {
            <p class="text-secondary mb-0">No hay tokens activos.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Expira</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var token in ValidTokens)
                        {
                            <tr>
                                <td>@token.AgentUserId</td>
                                <td>@token.ExpiresAt.ToLocalTime().ToString("g")</td>
                                <td><span class="badge text-bg-success">Válido</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

<section class="card border-0 shadow-sm">
    <div class="card-body">
        <h2 class="h5">Historial reciente</h2>
        @if (History.Count == 0)
        {
            <p class="text-secondary mb-0">Todavía no hay reproducciones registradas.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Consulta</th>
                            <th>Fecha</th>
                            <th>Resultado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in History)
                        {
                            <tr>
                                <td>@item.Query</td>
                                <td>@item.Date.ToLocalTime().ToString("g")</td>
                                <td>
                                    <span class="badge @(item.Success ? "text-bg-success" : "text-bg-danger")">
                                        @(item.Success ? "Correcto" : "Fallido")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

<section class="card border-0 shadow-sm">
    <div class="card-body">
        <h2 class="h5">Codes</h2>
        @if (Codes == null || Codes.Count == 0)
        {
            <p class="text-secondary mb-0">Todavía no hay reproducciones registradas.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Fecha</th>
                            <th>Usado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Codes)
                        {
                            <tr>
                                <td>@item.Code</td>
                                <td>@item.ExpiresAt.ToLocalTime().ToString("g")</td>
                                <td>
                                    <span class="badge @(item.IsUsed ? "text-bg-success" : "text-bg-danger")">
                                        @(item.IsUsed ? "Usado" : "No usado")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

<section class="card border-0 shadow-sm">
    <div class="card-body">
        <h2 class="h5">All Tokens</h2>
        @if (AllTokens == null || AllTokens.Count == 0)
        {
            <p class="text-secondary mb-0">Todavía no hay tokens registrados.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Fecha</th>
                            <th>Agente</th>
                            <th>Refresh Token</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in AllTokens)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.AccessExpiresAt.ToLocalTime().ToString("g")</td>
                                <td>@item.AgentUserId</td>
                                <td>@item.RefreshToken</td>                                
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>