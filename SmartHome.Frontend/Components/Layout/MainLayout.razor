@inherits LayoutComponentBase

<div class="app-shell">
	<header class="navbar navbar-expand-lg navbar-dark bg-dark">
		<div class="container">
			<a class="navbar-brand fw-semibold" href="/">Smart Home Media Bridge</a>
			<nav class="navbar-nav ms-auto flex-row gap-3">
				<a class="nav-link" href="/">Inicio</a>
				<a class="nav-link" href="/dashboard">Dashboard</a>
				<a class="nav-link" href="/oauth/authorize">Vincular Google Home</a>
				<AuthorizeView>
					<Authorized>
						<form method="post" action="/logout" class="d-inline">
							<AntiforgeryToken />
							<button class="btn btn-sm btn-outline-light" type="submit">Salir</button>
						</form>
					</Authorized>
				</AuthorizeView>
			</nav>
		</div>
	</header>

	<main class="container py-4">
		@Body
	</main>
</div>
